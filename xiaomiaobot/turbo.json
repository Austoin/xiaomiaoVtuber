{
  "$schema": "https://turborepo.com/schema.json",
  "cacheDir": "../.cache/turbo/xiaomiaobot",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
